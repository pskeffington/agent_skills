{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "base_commit",
    "objective",
    "scope",
    "acceptance",
    "risk",
    "owner_role",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,64}$"
    },
    "repository": {
      "type": "string",
      "minLength": 3
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owner_role": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "ready",
        "running",
        "blocked",
        "review",
        "done"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
