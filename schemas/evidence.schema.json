{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "stage",
    "source_commit",
    "result",
    "checks",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_id": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "result",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "provenance": {
            "type": "string",
            "minLength": 4
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "blocker": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
