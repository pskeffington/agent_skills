{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pskeffington/agent_skills/blob/main/schemas/rf-software-master-operator.schema.json",
  "title": "RF software master operator catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "source_of_truth",
    "execution_model",
    "operator",
    "states",
    "profiles",
    "agents",
    "components",
    "handoff",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string"
    },
    "source_of_truth": {
      "type": "object"
    },
    "execution_model": {
      "type": "string"
    },
    "operator": {
      "type": "object",
      "required": [
        "id",
        "reports_to",
        "role",
        "permissions",
        "human_approval"
      ],
      "properties": {
        "id": {
          "const": "rf-software-master-operator"
        },
        "reports_to": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "write_permission": {
          "type": "string"
        },
        "human_approval": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "depends_on",
          "default_enabled"
        ],
        "properties": {
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default_enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "skill_path",
          "profiles",
          "capabilities"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "skill_path": {
            "type": "string"
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner",
          "reviewer",
          "capability",
          "profile",
          "dependencies",
          "hardware_adapters",
          "installation_policy",
          "status",
          "acceptance_record"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "capability": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hardware_adapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installation_policy": {
            "enum": [
              "pacman-candidate",
              "manual-review",
              "venv-manual-review",
              "os-provided"
            ]
          },
          "status": {
            "type": "string"
          },
          "acceptance_record": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "handoff": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    }
  }
}
